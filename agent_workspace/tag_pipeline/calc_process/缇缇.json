      },
      "note": "沉睡中的敌人每秒受到缇缇 30% 攻击力法术伤害；沉睡状态须由其他来源施加",
      "scenarios": {
        "normal": [
          {
            "section": "① 前提",
            "title": "结算间隔",
            "expr": "1.0 × 30",
            "result": "30",
            "unit": "帧",
            "note": "【沉睡检测】自 0.5 秒开始每 1.0 秒判定一次；第一天赋精英1 即生效，取精英2 满配档"
          },
          {
            "section": "② 单次效果",
            "title": "单跳倍率",
            "result": "30",
            "unit": "%",
            "note": "精英2 为 30%（精英1 为 18%）"
          },
          {
            "section": "③ 生效次数",
            "title": "50 秒内的跳数",
            "expr": "50 × 30 ÷ 30",
            "result": "50",
            "unit": "跳",
            "note": "常驻效果按 50 秒折算"
          },
          {
            "section": "④ 是否达线",
            "title": "等效每秒段数",
            "expr": "1 ÷ 1.0",
            "result": "1",
            "unit": "段/秒",
            "note": "与成绩块一致；50 跳不低于对单门槛 50"
          }
        ]
      }
    },
